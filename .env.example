# AI provider configuration
# Use "none" for pre-annotated fixture demo mode (no external AI calls).
# Set AI_PROVIDER=gemini and provide GEMINI_API_KEY to enable live Gemini Vision analysis.
AI_PROVIDER=none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_SECONDS=30
MAX_UPLOAD_MB=5

# Production readiness controls (Phase 12)
# Set to false to restrict the app strictly to P0 core domains (Physics + Biology).
ENABLE_EXPERIMENTAL_DOMAINS=true
ANALYZE_RATE_LIMIT_PER_MIN=20
