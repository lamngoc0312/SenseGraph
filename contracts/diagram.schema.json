{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/sensegraph/diagram.schema.json",
  "title": "SenseGraph DiagramDocument v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "domain",
    "summary",
    "source",
    "review_status",
    "nodes",
    "edges",
    "domain_model",
    "warnings"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "enum": [
        "physics_circuit",
        "biology_food_web"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "filename",
        "provider"
      ],
      "properties": {
        "mode": {
          "enum": [
            "fixture",
            "ai"
          ]
        },
        "filename": {
          "type": "string"
        },
        "provider": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "review_status": {
      "enum": [
        "unreviewed",
        "confirmed"
      ]
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "label",
          "description",
          "attributes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "kind": {
            "enum": [
              "battery",
              "switch",
              "bulb",
              "organism"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "attributes": {
            "type": "object"
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "source",
          "target",
          "relation",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "source": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "target": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "relation": {
            "enum": [
              "wire",
              "energy_to"
            ]
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "domain_model": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "sequence",
            "switch_states",
            "loop_wired"
          ],
          "properties": {
            "kind": {
              "const": "series_circuit"
            },
            "sequence": {
              "type": "array",
              "minItems": 3,
              "maxItems": 4,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
              },
              "uniqueItems": true
            },
            "switch_states": {
              "type": "object",
              "minProperties": 1,
              "maxProperties": 1,
              "additionalProperties": {
                "enum": [
                  "open",
                  "closed"
                ]
              }
            },
            "loop_wired": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "arrow_convention"
          ],
          "properties": {
            "kind": {
              "const": "food_web"
            },
            "arrow_convention": {
              "const": "food_to_consumer"
            }
          }
        }
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "domain": {
            "const": "physics_circuit"
          }
        }
      },
      "then": {
        "properties": {
          "domain_model": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "sequence",
              "switch_states",
              "loop_wired"
            ],
            "properties": {
              "kind": {
                "const": "series_circuit"
              },
              "sequence": {
                "type": "array",
                "minItems": 3,
                "maxItems": 4,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
                },
                "uniqueItems": true
              },
              "switch_states": {
                "type": "object",
                "minProperties": 1,
                "maxProperties": 1,
                "additionalProperties": {
                  "enum": [
                    "open",
                    "closed"
                  ]
                }
              },
              "loop_wired": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "domain": {
            "const": "biology_food_web"
          }
        }
      },
      "then": {
        "properties": {
          "domain_model": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "arrow_convention"
            ],
            "properties": {
              "kind": {
                "const": "food_web"
              },
              "arrow_convention": {
                "const": "food_to_consumer"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "properties": {
              "mode": {
                "const": "ai"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "source": {
            "properties": {
              "provider": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  ]
}
